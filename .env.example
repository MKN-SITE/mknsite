# ==============================================================================
# MKN SITE - ENVIRONMENT VARIABLES CHEATSHEET & TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT (Laptop / PC)
# Simpan nilai berikut di file `.env` di root atau di masing-masing apps.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
DATABASE_URL=mysql://mknsite:mknsite-local-only@localhost:3306/mknsite
COOKIE_DOMAIN=
NODE_ENV=development
ENABLE_SWAGGER=true
DOCS_PROVIDER=swagger-ui

# ------------------------------------------------------------------------------
# 2. PRODUCTION - FRONTEND (Diatur di Vercel Dashboard -> Settings -> Env Vars)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.mknsite.online

# ------------------------------------------------------------------------------
# 3. PRODUCTION - BACKEND (Diatur di Coolify Dashboard -> mknsite-api -> Env Vars)
# ------------------------------------------------------------------------------
# PORT=3001
# APP_ORIGIN=https://mknsite.online,https://www.mknsite.online
# BETTER_AUTH_URL=https://api.mknsite.online
# BETTER_AUTH_SECRET=<SECRET_ACAK_MINIMAL_32_KARAKTER_DARI_SECRET_MANAGER>
# DATABASE_URL=mysql://mknsite:<PASSWORD_DARI_SECRET_MANAGER>@<DB_CONTAINER_HOST>:3306/mknsite
# COOKIE_DOMAIN=.mknsite.online
# NODE_ENV=production
# ENABLE_SWAGGER=false
# DOCS_PROVIDER=swagger-ui
