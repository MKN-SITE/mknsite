# API Environment Variables
# -------------------------------------------------------------
# LOCAL (set in apps/api/.env):
PORT=3001
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
DATABASE_URL=mysql://mknsite:mknsite-local-only@localhost:3306/mknsite
COOKIE_DOMAIN=
NODE_ENV=development
ENABLE_SWAGGER=true
DOCS_PROVIDER=swagger-ui
BETTER_AUTH_SECRET=mknsite-local-dev-secret-key-32ch
SEED_ADMIN_PASSWORD=admin123
SEED_SUPERADMIN_PASSWORD=superadmin123
SEED_HR_PASSWORD=hr123

# -------------------------------------------------------------
# PRODUCTION (set in Coolify Dashboard -> Environment Variables):
# PORT=3001
# APP_ORIGIN=https://mknsite.online,https://www.mknsite.online
# BETTER_AUTH_URL=https://api.mknsite.online
# DATABASE_URL=mysql://mknsite:<PASSWORD>@<DB_HOST>:3306/mknsite
# COOKIE_DOMAIN=.mknsite.online
# NODE_ENV=production
# ENABLE_SWAGGER=false
# BETTER_AUTH_SECRET=generate-a-secure-random-32-character-secret-key-here
# SEED_ADMIN_PASSWORD=
# SEED_SUPERADMIN_PASSWORD=
# SEED_HR_PASSWORD=
